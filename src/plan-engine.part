/* ================= Plan-Engine ================= */
function Plan(opt){
  var self=this;
  this.o=opt; this.el=document.getElementById(opt.mount); this.seq=1000;
  this.base={rows:opt.rows, groups:opt.groups, blocks:opt.blocks};
  this.restore(); this.sel=null; this.render();
  window.addEventListener("resize",function(){self.position();});
}
Plan.prototype.g=function(id){for(var i=0;i<this.groups.length;i++) if(this.groups[i].id===id) return this.groups[i];};
Plan.prototype.b=function(id){for(var i=0;i<this.blocks.length;i++) if(this.blocks[i].id===id) return this.blocks[i];};
Plan.prototype.row=function(id){for(var i=0;i<this.rows.length;i++) if(this.rows[i].id===id) return this.rows[i];};
Plan.prototype.dur=function(b){return this.g(b.gid).n*CLIMB;};
Plan.prototype.parts=function(g){return this.groups.filter(function(x){return x.cls===g.cls&&x.gender===g.gender;});};
Plan.prototype.gname=function(g){return CLn(g.cls)+" "+gl(g.cls,g.gender);};
Plan.prototype.label=function(g){var p=this.parts(g), n=this.gname(g);return p.length<2?n:n+" "+(p.indexOf(g)+1);};
Plan.prototype.desc=function(r){
  var d=CLn(r.cls)+" · "+allowTxt(r)+" · "+r.mode;
  if(r.dir==="ab") d+=" · Start n→1";
  return d;
};
/* Individuelle Pause zwischen zwei Runden: normalerweise für alle in der
   Gruppe gleich (Blockabstand). Läuft eine der beiden Routen mit gedrehter
   Startreihenfolge (dir "ab" statt "auf"), ist die Pause nicht mehr für
   alle gleich – wer auf Route 1 zuerst dran ist, ist auf Route 2 zuletzt
   dran (oder umgekehrt), daher die Spanne lo..hi statt eines Einzelwerts. */
Plan.prototype.pauseRange=function(g,bs){
  var r0=this.row(bs[0].r), r1=this.row(bs[1].r), n=g.n;
  var dir0=!!(r0&&r0.dir==="ab"), dir1=!!(r1&&r1.dir==="ab");
  var base=bs[1].s-bs[0].s, lo=base, hi=base;
  if(dir0!==dir1&&n>1){ lo=base-(n-1)*CLIMB; hi=base+(n-1)*CLIMB; }
  return {lo:lo, hi:hi, uneven:lo!==hi};
};
Plan.prototype.pauseTxt=function(g,bs){
  var pr=this.pauseRange(g,bs);
  return {txt:(pr.uneven?pr.lo+"–"+pr.hi:pr.lo)+" Min", ok:pr.lo>=45&&pr.hi<=65, uneven:pr.uneven};
};
Plan.prototype.save=function(){
  var st={rows:this.rows,groups:this.groups,blocks:this.blocks,seq:this.seq};
  try{localStorage.setItem(this.o.store,JSON.stringify(st));}catch(e){}
  pushState(this.o.kind,st);
};
Plan.prototype.restore=function(){
  this.rows=clone(this.base.rows); this.groups=clone(this.base.groups); this.blocks=clone(this.base.blocks);
  try{
    var st=JSON.parse(localStorage.getItem(this.o.store)||"null");
    if(st&&st.rows&&st.groups&&st.blocks&&st.rows.length&&st.groups.length){
      this.rows=st.rows; this.groups=st.groups; this.blocks=st.blocks; this.seq=st.seq||1000;
    }
  }catch(e){}
  this.prune();
};
/* Zeilen und Gruppen entfernen, deren Wertungsklasse es nicht mehr gibt */
Plan.prototype.prune=function(){
  var known={}; CFG.classes.forEach(function(c){known[c.id]=1;});
  var gone={};
  this.groups=this.groups.filter(function(g){ if(known[g.cls]) return true; gone[g.id]=1; return false; });
  this.rows=this.rows.filter(function(r){return known[r.cls];});
  var rows={}; this.rows.forEach(function(r){rows[r.id]=1;});
  var gs={}; this.groups.forEach(function(g){gs[g.id]=1;});
  this.blocks=this.blocks.filter(function(b){return gs[b.gid]&&rows[b.r];});
  if(!this.rows.length&&CFG.classes.length)
    this.rows.push({id:this.o.prefix+"1",cls:CFG.classes[0].id,allow:"mw",mode:CFG.classes[0].mode||"TR"});
};
Plan.prototype.reset=function(){
  try{localStorage.removeItem(this.o.store);}catch(e){}
  this.rows=clone(this.base.rows); this.groups=clone(this.base.groups); this.blocks=clone(this.base.blocks);
  this.seq=1000; this.sel=null; this.applyField(); this.render();
};
/* Meldezahlen auf die Gruppen verteilen */
Plan.prototype.setTotal=function(cls,gender,total){
  var self=this, parts=this.groups.filter(function(g){return g.cls===cls&&g.gender===gender;});
  if(!parts.length) return;
  total=Math.max(0,Math.round(total));
  while(parts.length>Math.max(1,total)){
    var drop=parts.pop();
    this.blocks.filter(function(b){return b.gid===drop.id;}).forEach(function(b){
      var d=self.nodes&&self.nodes[b.id]; if(d&&d.parentNode) d.parentNode.removeChild(d);
      if(self.nodes) delete self.nodes[b.id];
      self.blocks.splice(self.blocks.indexOf(b),1);
    });
    this.groups.splice(this.groups.indexOf(drop),1);
  }
  var k=parts.length, base=Math.floor(total/k), rem=total-base*k;
  parts.forEach(function(g,i){ g.n=base+(i<rem?1:0); });
};
Plan.prototype.applyField=function(){
  var self=this;
  CFG.classes.forEach(function(c){
    if(self.o.kind==="quali"){
      self.setTotal(c.id,"m",c.m); self.setTotal(c.id,"w",c.w);
    }else{
      var mix=self.groups.some(function(g){return g.cls===c.id&&g.gender==="mw";});
      if(mix) self.setTotal(c.id,"mw",quota(c.m)+quota(c.w));
      else { self.setTotal(c.id,"m",quota(c.m)); self.setTotal(c.id,"w",quota(c.w)); }
    }
  });
};
/* ---- Wertungsklassen ---- */
Plan.prototype.nextRoute=function(){
  var max=0, p=this.o.prefix;
  this.rows.forEach(function(r){var n=parseInt(String(r.id).replace(/\D/g,""),10); if(n>max) max=n;});
  return p+(max+1);
};
Plan.prototype.addClass=function(c){
  var self=this, t0, dm=(+c.m||0)*CLIMB, dw=(+c.w||0)*CLIMB;
  function row(allow){var id=self.nextRoute(); self.rows.push({id:id,cls:c.id,allow:allow,mode:c.mode}); return id;}
  function grp(gender,n){var g={id:newId("g"),cls:c.id,gender:gender,n:Math.max(0,n)}; self.groups.push(g); return g;}
  function blk(g,r,s){self.blocks.push({id:newId("b"),gid:g.id,r:r,s:Math.round(s/SNAP)*SNAP});}
  if(this.o.kind==="quali"){
    t0=this.o.start+15;
    var rm=row("mw"), r1=row("m"), r2=row("w");
    var gm=grp("m",c.m), gw=grp("w",c.w);
    var offW=Math.max(55,dm+5), offM=Math.max(55,dw+5);
    blk(gm,rm,t0); blk(gm,r1,Math.min(this.o.end-dm,t0+offM));
    blk(gw,r2,t0); blk(gw,rm,Math.min(this.o.end-dw,t0+offW));
  }else{
    t0=this.o.start+(CFG.win.bes||25)+(CFG.win.iso||20);
    var ra=row("w"), rb=row("m");
    var ga=grp("w",quota(c.w)), gb=grp("m",quota(c.m));
    blk(ga,ra,t0); blk(gb,rb,t0);
  }
  this.render(); this.save();
};
Plan.prototype.delClass=function(id){
  var self=this;
  var gone={}; this.groups.filter(function(g){return g.cls===id;}).forEach(function(g){gone[g.id]=1;});
  this.blocks=this.blocks.filter(function(b){return !gone[b.gid];});
  this.groups=this.groups.filter(function(g){return g.cls!==id;});
  this.rows=this.rows.filter(function(r){return r.cls!==id;});
  if(!this.rows.length) this.rows.push({id:this.o.prefix+"1",cls:(CFG.classes[0]||{}).id,allow:"mw",mode:"TR"});
  this.sel=null; this.render(); this.save();
};
Plan.prototype.window=function(s,e){
  this.o.start=s; this.o.end=e;
  var span=Math.max(30,e-s);
  this.o.step=span>300?60:(span>150?30:15);
  var self=this;
  this.blocks.forEach(function(b){
    var d=self.dur(b);
    b.s=Math.max(s,Math.min(e-d,b.s));
  });
  this.render(); this.save();
};

/* ---- Routen ---- */
Plan.prototype.addRoute=function(cls,allow,mode){
  var max=0;
  this.rows.forEach(function(r){var n=parseInt(r.id.replace(/\D/g,""),10); if(n>max) max=n;});
  var idx=this.rows.length;
  for(var i=this.rows.length-1;i>=0;i--) if(this.rows[i].cls===cls){idx=i+1;break;}
  this.rows.splice(idx,0,{id:this.o.prefix+(max+1),cls:cls,allow:allow,mode:mode});
  this.render(); this.save();
};
Plan.prototype.delRoute=function(id){
  if(this.blocks.some(function(b){return b.r===id;})) return false;
  if(this.rows.length<2) return false;
  this.rows=this.rows.filter(function(r){return r.id!==id;});
  this.render(); this.save(); return true;
};
/* Manuell einen weiteren Balken für eine Klasse anlegen - anders als
   addClass() KEINE neuen Gruppen, sondern ein zusätzlicher Termin für die
   schon vorhandene männliche/weibliche Gruppe dieser Klasse (dasselbe
   Muster wie die zwei Balken, die addClass() für Quali bereits auf zwei
   Routen verteilt). Ohne vorhandene Gruppe für eine Seite (Klasse in
   diesem Plan noch gar nicht angelegt) wird diese Seite übersprungen. */
Plan.prototype.addBlock=function(cls,routeId,start){
  if(!this.row(routeId)) return false;
  var self=this, added=false;
  ["m","w"].forEach(function(gender){
    var g=self.groups.filter(function(x){return x.cls===cls&&x.gender===gender;})[0];
    if(!g) return;
    self.blocks.push({id:"b"+(++self.seq), gid:g.id, r:routeId, s:Math.round(start/SNAP)*SNAP});
    added=true;
  });
  if(!added) return false;
  this.render(); this.save(); return true;
};
Plan.prototype.delBlock=function(blockId){
  if(!this.blocks.some(function(b){return b.id===blockId;})) return false;
  this.blocks=this.blocks.filter(function(b){return b.id!==blockId;});
  if(this.sel===blockId) this.sel=null;
  this.render(); this.save(); return true;
};
Plan.prototype.toggleDir=function(id){
  var r=this.row(id); if(!r) return;
  r.dir=r.dir==="ab"?"auf":"ab";
  this.render(); this.save();
};
Plan.prototype.toggleAlt=function(id){
  var r=this.row(id); if(!r||r.allow!=="mw") return;
  r.altStart=!r.altStart;
  this.render(); this.save();
};
/* Auf einer "abwechselnd m/w" Route: zwei direkt aneinander anschließende
   Blöcke derselben Klasse (ein m-, ein w-Block) verschmelzen zu einem
   einzigen Balken. Wird bei jedem render() neu ermittelt (nie gespeichert),
   damit eine Trennung durch Teilen/Verschieben sich von selbst wieder löst. */
Plan.prototype.findMergePairs=function(){
  var self=this, pairs={}, tails={};
  this.rows.forEach(function(r){
    if(!r.altStart) return;
    var byCls={};
    self.blocks.filter(function(b){return b.r===r.id;}).forEach(function(b){
      var g=self.g(b.gid); if(!g||(g.gender!=="m"&&g.gender!=="w")) return;
      (byCls[g.cls]=byCls[g.cls]||[]).push(b);
    });
    Object.keys(byCls).forEach(function(cls){
      var list=byCls[cls]; if(list.length!==2) return;
      var g0=self.g(list[0].gid), g1=self.g(list[1].gid); if(g0.gender===g1.gender) return;
      var e0=list[0].s+self.dur(list[0]), e1=list[1].s+self.dur(list[1]), head,tail;
      if(e0===list[1].s){head=list[0]; tail=list[1];}
      else if(e1===list[0].s){head=list[1]; tail=list[0];}
      else return;
      pairs[head.id]=tail.id; tails[tail.id]=head.id;
    });
  });
  return {pairs:pairs, tails:tails};
};

/* ---- Rendern ---- */
Plan.prototype.render=function(){
  var o=this.o, span=o.end-o.start, ticks=span/o.step, h="", self=this;
  h+='<div class="grow gaxis"><div class="rlabel"><b style="color:var(--muted)">'+esc(o.axisLabel)+'</b></div><div class="track">';
  for(var i=0;i<=ticks;i++) h+='<span class="t" style="left:'+((i/ticks)*100).toFixed(3)+'%">'+fmt(o.start+i*o.step)+'</span>';
  h+='</div></div>';
  this.rows.forEach(function(r){
    var busy=self.blocks.some(function(b){return b.r===r.id;});
    h+='<div class="grow" data-ac="'+ACOF[r.cls]+'"><div class="rlabel"><b>'+esc(r.id)+
       '<span class="rbtns">'+
       (r.allow==="mw"?'<button class="ralt" type="button" data-alt="'+r.id+'" aria-pressed="'+(r.altStart?"true":"false")+
         '" title="Startreihenfolge auf dieser Route abwechselnd m/w statt erst alle Jungs, dann alle Mädchen">↔ m/w</button>':"")+
       '<button class="rdir" type="button" data-dir="'+r.id+'" title="Startreihenfolge '+
         (r.dir==="ab"?"absteigend (letzte Startnummer zuerst)":"aufsteigend (Startnummer 1 zuerst)")+' – zum Umkehren klicken" aria-label="Startreihenfolge '+
         (r.dir==="ab"?"absteigend (letzte Startnummer zuerst)":"aufsteigend (Startnummer 1 zuerst)")+' – zum Umkehren klicken">'+
         (r.dir==="ab"?"n→1":"1→n")+'</button>'+
       '<button class="rdel" type="button" data-del="'+r.id+'" title="'+(busy?"Route ist belegt – erst Balken wegziehen":"Route löschen")+'" aria-label="'+(busy?"Route ist belegt – erst Balken wegziehen":"Route löschen")+'"'+(busy?" disabled":"")+'>×</button>'+
       '</span></b>'+
       '<span>'+esc(self.desc(r))+'</span></div>';
    h+='<div class="track" data-route="'+r.id+'" style="--tick:'+(100/ticks).toFixed(4)+'%"></div></div>';
  });
  this.el.innerHTML=h;
  this.tracks={};
  Array.prototype.forEach.call(this.el.querySelectorAll(".track[data-route]"),function(t){self.tracks[t.getAttribute("data-route")]=t;});
  Array.prototype.forEach.call(this.el.querySelectorAll(".rdel"),function(btn){
    btn.onclick=function(ev){ev.stopPropagation(); self.delRoute(btn.getAttribute("data-del"));};
  });
  Array.prototype.forEach.call(this.el.querySelectorAll(".rdir"),function(btn){
    btn.onclick=function(ev){ev.stopPropagation(); self.toggleDir(btn.getAttribute("data-dir"));};
  });
  Array.prototype.forEach.call(this.el.querySelectorAll(".ralt"),function(btn){
    btn.onclick=function(ev){ev.stopPropagation(); self.toggleAlt(btn.getAttribute("data-alt"));};
  });
  this.nodes={};
  if(o.fixedGen) o.fixed=o.fixedGen(this);
  (o.fixed||[]).forEach(function(f){
    var t=self.tracks[f.r]; if(!t) return;
    var d=document.createElement("div");
    d.className="blk iso"; d.setAttribute("data-ac",ACOF[f.cls]); d.setAttribute("data-g","m");
    d.innerHTML='<b>'+esc(f.lab)+'</b><span>'+fmt(f.s)+'–'+fmt(f.s+f.dur)+'</span>';
    d.style.left=(((f.s-o.start)/span)*100).toFixed(3)+"%";
    d.style.width=((f.dur/span)*100).toFixed(3)+"%";
    t.appendChild(d);
  });
  this.altMerge=this.findMergePairs();
  this.blocks.forEach(function(b){ if(!self.altMerge.tails[b.id]) self.mount(b); });
  this.position(); this.recalc();
};
Plan.prototype.mount=function(b){
  var t=this.tracks[b.r]; if(!t) return;
  var g=this.g(b.gid); if(!g) return;
  var d=document.createElement("div");
  d.className="blk"; d.setAttribute("data-ac",ACOF[g.cls]); d.setAttribute("data-g",g.gender==="w"?"w":"m");
  d.setAttribute("tabindex","0"); d.setAttribute("role","button");
  d.innerHTML='<b></b><span></span><button class="blk-del" type="button" aria-label="'+esc(this.label(g))+' auf '+esc(b.r)+' löschen">×</button>';
  t.appendChild(d); this.nodes[b.id]=d; this.bind(d,b);
};
Plan.prototype.position=function(){
  var o=this.o, span=o.end-o.start, self=this;
  this.blocks.forEach(function(b){
    var d=self.nodes[b.id]; if(!d) return;
    var g=self.g(b.gid), dur=self.dur(b);
    var tailId=self.altMerge.pairs[b.id], tail=tailId?self.b(tailId):null;
    var endS=tail?tail.s+self.dur(tail):b.s+dur;
    d.style.left=(((b.s-o.start)/span)*100).toFixed(3)+"%";
    d.style.width=(((endS-b.s)/span)*100).toFixed(3)+"%";
    if(tail){
      var n=g.n+self.g(tail.gid).n, lab=CLn(g.cls)+" männlich + weiblich · abwechselnd";
      d.querySelector("b").textContent=lab;
      d.querySelector("span").textContent=fmt(b.s)+"–"+fmt(endS)+" · "+n+" TN";
      d.title=b.r+" · "+lab+" · "+fmt(b.s)+"–"+fmt(endS)+" · "+n+" Kletternde";
    } else {
      d.querySelector("b").textContent=self.label(g);
      d.querySelector("span").textContent=fmt(b.s)+"–"+fmt(b.s+dur)+" · "+g.n+" TN";
      d.title=b.r+" · "+self.label(g)+" · "+fmt(b.s)+"–"+fmt(b.s+dur)+" · "+g.n+" Kletternde";
    }
    d.classList.toggle("merged", !!tail);
    d.classList.toggle("sel", self.sel===b.id);
    d.classList.toggle("dim", !!self.filter && g.cls!==self.filter);
  });
};
Plan.prototype.bind=function(d,b){
  var self=this, o=this.o, drag=null;
  function tailOf(){ var tid=self.altMerge.pairs[b.id]; return tid?self.b(tid):null; }
  function maxStart(tail){ return o.end-self.dur(b)-(tail?self.dur(tail):0); }
  function onMove(ev){
    if(!drag) return;
    if(Math.abs(ev.clientX-drag.x)>3||Math.abs(ev.clientY-drag.y)>3) drag.moved=true;
    var tail=tailOf();
    var ns=Math.round((drag.s0+(ev.clientX-drag.x)/drag.ppm)/SNAP)*SNAP;
    ns=Math.max(o.start,Math.min(maxStart(tail),ns));
    var ch=false;
    if(ns!==b.s){var delta=ns-b.s; b.s=ns; if(tail) tail.s+=delta; ch=true;}
    var tgt=self.rowAt(ev.clientY);
    if(tgt&&tgt!==b.r){b.r=tgt; if(tail) tail.r=tgt; self.tracks[tgt].appendChild(d); ch=true;}
    if(ch){self.position(); self.recalc();}
    ev.preventDefault();
  }
  function onUp(){
    if(!drag) return;
    var moved=drag.moved; drag=null; d.classList.remove("dragging");
    window.removeEventListener("pointermove",onMove);
    window.removeEventListener("pointerup",onUp);
    window.removeEventListener("pointercancel",onUp);
    if(!moved) self.select(b.id); else {self.save(); if(self.sel===b.id) self.editor();}
  }
  var delBtn=d.querySelector(".blk-del");
  if(delBtn){
    /* pointerdown muss VOR dem Drag-Handler des Balkens selbst gestoppt
       werden, sonst startet ein Klick auf "×" zusätzlich einen Drag. */
    delBtn.addEventListener("pointerdown",function(ev){ ev.stopPropagation(); });
    delBtn.addEventListener("click",function(ev){ ev.stopPropagation(); self.delBlock(b.id); });
  }
  d.addEventListener("pointerdown",function(ev){
    if(ev.button!==0&&ev.pointerType==="mouse") return;
    drag={x:ev.clientX,y:ev.clientY,s0:b.s,moved:false,
          ppm:d.parentNode.getBoundingClientRect().width/(o.end-o.start)};
    d.classList.add("dragging");
    window.addEventListener("pointermove",onMove);
    window.addEventListener("pointerup",onUp);
    window.addEventListener("pointercancel",onUp);
    ev.preventDefault();
  });
  d.addEventListener("keydown",function(ev){
    var k=ev.key, step=(ev.shiftKey?1:SNAP), tail=tailOf();
    if(k==="ArrowLeft"||k==="ArrowRight"){
      ev.preventDefault();
      var ns=Math.max(o.start,Math.min(maxStart(tail), b.s+(k==="ArrowLeft"?-step:step)));
      var delta=ns-b.s; b.s=ns; if(tail) tail.s+=delta;
    } else if(k==="ArrowUp"||k==="ArrowDown"){
      ev.preventDefault();
      var idx=self.rows.map(function(r){return r.id;}).indexOf(b.r)+(k==="ArrowUp"?-1:1);
      if(idx<0||idx>=self.rows.length) return;
      b.r=self.rows[idx].id; if(tail) tail.r=b.r; self.tracks[b.r].appendChild(d); d.focus();
    } else if(k==="Enter"||k===" "){ev.preventDefault(); self.select(b.id); return;}
    else return;
    self.position(); self.recalc(); self.save(); if(self.sel===b.id) self.editor();
  });
};
Plan.prototype.rowAt=function(y){
  var hit=null, self=this;
  Object.keys(this.tracks).forEach(function(id){
    var r=self.tracks[id].getBoundingClientRect();
    if(y>=r.top&&y<=r.bottom) hit=id;
  });
  return hit;
};
Plan.prototype.select=function(id){this.sel=id; this.position(); this.editor();};
Plan.prototype.split=function(gid,nNew){
  var g=this.g(gid); if(!g||g.n<2) return;
  nNew=Math.max(1,Math.min(g.n-1,Math.round(nNew)));
  var ng={id:"g"+(++this.seq), cls:g.cls, gender:g.gender, n:nNew};
  g.n-=nNew;
  this.groups.splice(this.groups.indexOf(g)+1,0,ng);
  var self=this;
  this.blocks.filter(function(b){return b.gid===gid;}).forEach(function(b){
    var nb={id:"b"+(++self.seq), gid:ng.id, r:b.r, s:Math.min(self.o.end-nNew*CLIMB, b.s+g.n*CLIMB+5)};
    self.blocks.push(nb); self.mount(nb);
  });
  this.sel=null; this.position(); this.recalc(); this.save(); this.editor();
};
Plan.prototype.merge=function(g0){
  var parts=this.parts(g0); if(parts.length<2) return;
  var keep=parts[0], self=this;
  parts.slice(1).forEach(function(g){
    keep.n+=g.n;
    self.blocks.filter(function(b){return b.gid===g.id;}).forEach(function(b){
      var d=self.nodes[b.id]; if(d&&d.parentNode) d.parentNode.removeChild(d);
      delete self.nodes[b.id]; self.blocks.splice(self.blocks.indexOf(b),1);
    });
    self.groups.splice(self.groups.indexOf(g),1);
  });
  this.sel=null; this.position(); this.recalc(); this.save(); this.editor();
};
Plan.prototype.list=function(){
  var self=this;
  return this.blocks.map(function(b){var g=self.g(b.gid);
    return {id:b.id,gid:g.id,r:b.r,s:b.s,e:b.s+self.dur(b),cls:g.cls,gender:g.gender,n:g.n,lab:self.label(g)};});
};
Plan.prototype.recalc=function(){
  var self=this, o=this.o, list=this.list(), clash={}, warn={};
  for(var i=0;i<list.length;i++){
    var row=this.row(list[i].r);
    if(row&&(row.cls!==list[i].cls||(row.allow!=="mw"&&row.allow!==list[i].gender&&list[i].gender!=="mw"))) warn[list[i].id]=1;
    for(var j=i+1;j<list.length;j++)
      if(list[i].r===list[j].r&&list[i].s<list[j].e&&list[j].s<list[i].e){clash[list[i].id]=1;clash[list[j].id]=1;}
  }
  Object.keys(this.nodes).forEach(function(k){
    self.nodes[k].classList.toggle("clash",!!clash[k]);
    self.nodes[k].classList.toggle("warn",!!warn[k]&&!clash[k]);
  });
  var ev=[]; list.forEach(function(b){ev.push(b.s);ev.push(b.e);});
  ev.sort(function(a,b){return a-b;});
  var maxR=0,end=o.start;
  ev.forEach(function(t){var rs={};list.forEach(function(b){if(b.s<=t&&t<b.e)rs[b.r]=1;});
    var c=Object.keys(rs).length; if(c>maxR)maxR=c;});
  list.forEach(function(b){if(b.e>end)end=b.e;});
  var maxCls=0;
  CLASSES.forEach(function(cl){
    var sub=list.filter(function(b){return b.cls===cl;}); if(!sub.length)return;
    var m=0; ev.forEach(function(t){var rs={};sub.forEach(function(b){if(b.s<=t&&t<b.e)rs[b.r]=1;});
      var c=Object.keys(rs).length; if(c>m)m=c;});
    if(m>maxCls)maxCls=m;
  });
  var nc=Object.keys(clash).length, nw=Object.keys(warn).length;
  this.stat={end:end,maxR:maxR,maxCls:maxCls,clash:nc,warn:nw,list:list};
  document.getElementById(o.readout).innerHTML=
    '<span>Ende</span> <b>'+fmt(end)+'</b>'+
    '<span>gleichzeitig</span> <b>'+maxR+' Routen</b>'+
    '<span>Routen-Teams</span> <b>'+maxR+' × '+CFG.teamPers+' = '+(maxR*CFG.teamPers)+' Personen</b>'+
    '<span>je Klasse max.</span> <b>'+maxCls+' Routen</b>'+
    '<span class="flag'+(nc?" bad":"")+'">'+(nc?nc+(nc===1?" Doppelbelegung":" Doppelbelegungen"):"keine Doppelbelegung")+'</span>'+
    (nw?'<span class="flag warn">'+nw+(nw===1?" Block":" Blöcke")+' auf fremder Route</span>':'');
  if(o.laufkarte) this.laufkarte(list);
  if(o.onchange) o.onchange(this,list);
};
Plan.prototype.laufkarte=function(list){
  var self=this,by={},h="";
  list.forEach(function(b){by[b.id]=b;});
  this.groups.forEach(function(g){
    var bs=self.blocks.filter(function(b){return b.gid===g.id;}).map(function(b){return by[b.id];})
            .sort(function(a,b){return a.s-b.s;});
    if(bs.length<2) return;
    var pt=self.pauseTxt(g,bs);
    h+='<tr data-ac="'+ACOF[g.cls]+'"><td><span class="ac">'+esc(self.label(g))+'</span></td><td class="num">'+g.n+'</td>'+
       '<td class="tm">'+bs[0].r+' · '+fmt(bs[0].s)+'–'+fmt(bs[0].e)+'</td>'+
       '<td class="tm">'+bs[1].r+' · '+fmt(bs[1].s)+'–'+fmt(bs[1].e)+'</td>'+
       '<td class="num"><span class="pill '+(pt.ok?"ok":"bad")+'"'+(pt.uneven?' title="Startreihenfolge auf den beiden Routen ist gegeneinander gedreht: die Pause ist nicht für alle in der Gruppe gleich."':'')+'>'+pt.txt+'</span></td></tr>';
  });
  document.querySelector(this.o.laufkarte+" tbody").innerHTML=h;
};
Plan.prototype.editor=function(){
  var box=document.getElementById(this.o.editor); if(!box) return;
  var b=this.sel?this.b(this.sel):null;
  if(!b){box.hidden=true; box.innerHTML=""; return;}
  var g=this.g(b.gid), self=this, parts=this.parts(g);
  var opts=this.rows.map(function(r){
    return '<option value="'+r.id+'"'+(r.id===b.r?" selected":"")+'>'+r.id+' – '+esc(self.desc(r))+'</option>';}).join("");
  box.hidden=false;
  box.innerHTML=
   '<div class="ed-head" data-ac="'+ACOF[g.cls]+'"><b>'+esc(this.label(g))+'</b> <span>'+g.n+' TN · '+b.r+' · '+fmt(b.s)+'–'+fmt(b.s+this.dur(b))+'</span>'+
   '<button class="fbtn ed-close" type="button">Auswahl aufheben</button></div>'+
   '<div class="ed-grid">'+
     '<label>Route <select class="ed-route">'+opts+'</select></label>'+
     '<label>Start <input class="ed-start" type="time" step="60" value="'+fmt(b.s)+'"></label>'+
     '<label>Teilen: <input class="ed-n" type="number" min="1" max="'+Math.max(1,g.n-1)+'" value="'+Math.floor(g.n/2)+'"'+(g.n<2?" disabled":"")+'> TN abtrennen'+
      ' <button class="fbtn ed-split" type="button"'+(g.n<2?" disabled":"")+'>Teilen</button></label>'+
     (parts.length>1?'<label><button class="fbtn ed-merge" type="button">„'+esc(this.gname(g))+'" zusammenführen</button></label>':'')+
   '</div>';
  var tailId=self.altMerge.pairs[b.id], tail=tailId?self.b(tailId):null;
  box.querySelector(".ed-close").onclick=function(){self.sel=null;self.position();self.editor();};
  box.querySelector(".ed-route").onchange=function(){
    b.r=this.value; if(tail) tail.r=b.r; self.tracks[b.r].appendChild(self.nodes[b.id]);
    self.position(); self.recalc(); self.save(); self.editor();};
  box.querySelector(".ed-start").onchange=function(){
    /* Bewusst ohne SNAP-Rundung: per Balken-Ziehen bleibt es beim 5-Minuten-
       Raster (leichter zu bedienen), aber wer die Zeit hier direkt einträgt,
       will genau diese Minute – nicht auf 5 gerundet. */
    var v=parseTime(this.value); if(v==null) return;
    var maxS=self.o.end-self.dur(b)-(tail?self.dur(tail):0);
    var ns=Math.max(self.o.start,Math.min(maxS,v)), delta=ns-b.s;
    b.s=ns; if(tail) tail.s+=delta;
    self.position(); self.recalc(); self.save(); self.editor();};
  var sp=box.querySelector(".ed-split");
  if(sp) sp.onclick=function(){self.split(g.id,+box.querySelector(".ed-n").value||1);};
  var mg=box.querySelector(".ed-merge");
  if(mg) mg.onclick=function(){self.merge(g);};
};

/* ================= Teams ================= */
function teams(plan,list){
  var occ={};
  list.forEach(function(b){
    var o=occ[b.r];
    if(!o) occ[b.r]={s:b.s,e:b.e,items:[b]};
    else {o.s=Math.min(o.s,b.s);o.e=Math.max(o.e,b.e);o.items.push(b);}
  });
  var items=plan.rows.filter(function(r){return occ[r.id];}).map(function(r){
    var o=occ[r.id]; o.items.sort(function(a,b){return a.s-b.s;});
    return {r:r.id,row:r,s:o.s,e:o.e,items:o.items};
  }).sort(function(a,b){return a.s-b.s||a.e-b.e;});
  var T=[];
  items.forEach(function(it){
    var pick=null;
    for(var i=0;i<T.length;i++) if(T[i].free<=it.s && T[i].cls===it.row.cls){pick=T[i];break;}
    if(!pick) for(var j=0;j<T.length;j++) if(T[j].free<=it.s){pick=T[j];break;}
    if(!pick){pick={idx:T.length+1,stations:[],free:-1,cls:it.row.cls};T.push(pick);}
    pick.stations.push(it); pick.free=it.e; pick.cls=it.row.cls;
  });
  return T;
}
function teamName(i){return "Team "+i+" · "+TEAMNAMES[(i-1)%TEAMNAMES.length];}
var LASTQ={T:[],list:[],plan:null};
function renderTeams(plan,list){
  if(!plan||!list) return;
  var tpIn=document.getElementById("teamPersIn");
  if(tpIn&&document.activeElement!==tpIn) tpIn.value=CFG.teamPers;
  var T=teams(plan,list), h="";
  LASTQ={T:T,list:list,plan:plan};
  T.forEach(function(t){
    var np=peopleOfTeam(t.idx).length;
    t.stations.forEach(function(st,i){
      var who=st.items.map(function(x){return x.lab+" ("+fmt(x.s)+"–"+fmt(x.e)+")";}).join(", ");
      h+='<tr data-ac="'+ACOF[st.row.cls]+'"'+(i===0?' class="tstart"':'')+'>'+
         '<td>'+(i===0?'<strong>Team '+t.idx+'</strong> · '+esc(TEAMNAMES[(t.idx-1)%TEAMNAMES.length]):'')+'</td>'+
         '<td class="tm">'+fmt(st.s)+'–'+fmt(st.e)+'</td>'+
         '<td><span class="ac">'+esc(st.r)+'</span> <span style="color:var(--muted)">'+esc(plan.desc(st.row))+'</span></td>'+
         '<td>'+esc(who)+'</td>'+
         (i===0?'<td rowspan="'+t.stations.length+'" style="vertical-align:top" class="pcell">'+teamPeopleHtml(t.idx)+'</td>':'')+
         '<td class="num">'+(i===0?(np?np+" / "+CFG.teamPers:CFG.teamPers):"")+'</td></tr>';
    });
  });
  var named=CFG.people.filter(function(p){return p.team;}).length;
  h+='<tr class="sum"><td>'+T.length+' Routen-Teams</td><td class="tm">—</td><td>'+plan.rows.length+' Routen gebaut</td>'+
     '<td>je Team: Sicherung + Ergebnisdienst</td><td>'+named+' Personen namentlich zugeteilt</td>'+
     '<td class="num">'+(T.length*CFG.teamPers)+'</td></tr>';
  document.querySelector("#teamtable tbody").innerHTML=h;
  document.getElementById("teamsum").textContent=T.length+" Routen-Teams à "+CFG.teamPers+" Personen = "+(T.length*CFG.teamPers)+" Personen"+
    (CFG.people.length?" · "+named+" von "+CFG.people.length+" erfassten Personen einem Team zugeordnet":"");
}

/* ================= Wege-Diagramm ================= */
function flowLanes(plan,list){
  var by={}; list.forEach(function(b){by[b.id]=b;});
  var lanes=[];
  plan.groups.forEach(function(g){
    var bs=plan.blocks.filter(function(b){return b.gid===g.id;}).map(function(b){return by[b.id];})
            .sort(function(a,b){return a.s-b.s;});
    if(bs.length) lanes.push({g:g,bs:bs,label:plan.label(g)});
  });
  return lanes;
}
function renderFlow(plan,list){
  var W=980, LAB=168, PAD=16, X0=LAB, X1=W-PAD, LANE=48, TOP=32;
  var t0=plan.o.start, t1=plan.o.end, span=t1-t0;
  var X=function(t){return X0+((t-t0)/span)*(X1-X0);};
  var lanes=flowLanes(plan,list);
  var H=TOP+lanes.length*LANE+14;
  var s='<svg viewBox="0 0 '+W+' '+H+'" width="'+W+'" height="'+H+'" role="img" aria-label="Wege der Startgruppen durch die Qualifikation">';
  s+='<defs><marker id="ah" markerWidth="7" markerHeight="7" refX="6" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6 z" fill="currentColor"/></marker></defs>';
  for(var t=Math.ceil(t0/30)*30;t<=t1;t+=30){
    s+='<line x1="'+X(t).toFixed(1)+'" y1="'+(TOP-10)+'" x2="'+X(t).toFixed(1)+'" y2="'+(H-8)+'" stroke="var(--line)" stroke-width="1"/>';
    s+='<text x="'+X(t).toFixed(1)+'" y="'+(TOP-16)+'" text-anchor="middle" font-family="var(--mono)" font-size="10.5" fill="var(--muted)">'+fmt(t)+'</text>';
  }
  lanes.forEach(function(L,i){
    var y=TOP+i*LANE, mid=y+26, g=L.g, w=g.gender==="w";
    s+='<g data-ac="'+ACOF[g.cls]+'" color="var(--ac)">';
    s+='<text x="8" y="'+(mid+4)+'" font-family="var(--disp)" font-size="13" font-weight="500" fill="var(--ac)">'+esc(L.label)+'</text>';
    s+='<text x="'+(LAB-14)+'" y="'+(mid+4)+'" text-anchor="end" font-family="var(--mono)" font-size="11" fill="var(--muted)">'+g.n+' TN</text>';
    L.bs.forEach(function(b,k){
      var x=X(b.s), bw=Math.max(6,X(b.e)-X(b.s));
      s+='<rect x="'+x.toFixed(1)+'" y="'+(mid-13)+'" width="'+bw.toFixed(1)+'" height="26" rx="3" fill="var('+(w?"--w-bg":"--m-bg")+')" stroke="var('+(w?"--w-br":"--m-br")+')"/>';
      s+='<rect x="'+x.toFixed(1)+'" y="'+(mid-13)+'" width="3" height="26" fill="var(--ac)"/>';
      if(bw>58) s+='<text x="'+(x+8).toFixed(1)+'" y="'+(mid-1)+'" font-family="var(--disp)" font-size="12" fill="var(--ink)">'+esc(b.r)+'</text>';
      if(bw>108) s+='<text x="'+(x+8).toFixed(1)+'" y="'+(mid+10)+'" font-family="var(--mono)" font-size="9.5" fill="var(--muted)">'+fmt(b.s)+'–'+fmt(b.e)+'</text>';
      if(k===1){
        var pt=plan.pauseTxt(g,L.bs), xa=X(L.bs[0].e)+3, xb=x-4;
        if(xb>xa+76){
          s+='<line x1="'+xa.toFixed(1)+'" y1="'+mid+'" x2="'+xb.toFixed(1)+'" y2="'+mid+'" stroke="var(--line-strong)" stroke-width="1.5" stroke-dasharray="3 3" marker-end="url(#ah)" color="var(--line-strong)"/>';
          s+='<text x="'+((xa+xb)/2).toFixed(1)+'" y="'+(mid-6)+'" text-anchor="middle" font-family="var(--mono)" font-size="9.5" fill="var('+(pt.ok?"--ok":"--bad")+')">Pause '+pt.txt+'</text>';
        } else {
          var x1=X(L.bs[0].s)+2, x2=x-2;
          s+='<path d="M'+x1.toFixed(1)+','+(mid-15)+' C'+x1.toFixed(1)+','+(mid-23)+' '+x2.toFixed(1)+','+(mid-23)+' '+x2.toFixed(1)+','+(mid-15)+'" fill="none" stroke="var(--line-strong)" stroke-width="1.2" stroke-dasharray="3 3" marker-end="url(#ah)" color="var(--line-strong)"/>';
          s+='<text x="'+((x1+x2)/2).toFixed(1)+'" y="'+(mid-25)+'" text-anchor="middle" font-family="var(--mono)" font-size="9.5" fill="var('+(pt.ok?"--ok":"--bad")+')">Pause '+pt.txt+'</text>';
        }
      }
    });
    s+='</g>';
  });
  s+='</svg>';
  document.getElementById("flow").innerHTML=s;
}

/* ================= Meldezahlen-Tabelle, Kennzahlen, Finalquoten ================= */
function classMode(plan,list,cls){
  var bs=list.filter(function(b){return b.cls===cls;});
  var gids={}; bs.forEach(function(b){gids[b.gid]=1;});
  if(Object.keys(gids).length<2) return "einzeln";
  var over=false, sep=false;
  for(var i=0;i<bs.length;i++) for(var j=i+1;j<bs.length;j++){
    if(bs[i].gid===bs[j].gid) continue;
    if(bs[i].s<bs[j].e&&bs[j].s<bs[i].e) over=true; else sep=true;
  }
  if(over&&sep) return "teils parallel";
  return over?"parallel":"nacheinander";
}
function afterCfg(replan){
  reindex(); saveCfg();
  if(replan!==false){ pq.applyField(); pf.applyField(); }
  pq.render(); pf.render(); pq.save(); pf.save();
  renderFilterBtns(); if(typeof fillAddRoute==="function") fillAddRoute();
}
function classInPlan(plan,classId){ return plan.rows.some(function(r){return r.cls===classId;}); }
function renderMeld(){
  var h="", tot={m:0,w:0,n:0,min:0};
  var qlist=(pq.stat&&pq.stat.list)||[];
  CFG.classes.forEach(function(c){
    var m=+c.m||0, w=+c.w||0, n=m+w;
    var min=qlist.filter(function(b){return b.cls===c.id;}).reduce(function(a,b){return a+(b.e-b.s);},0);
    tot.m+=m;tot.w+=w;tot.n+=n;tot.min+=min;
    var pal=PALETTE.map(function(p,i){return '<option value="'+i+'"'+(i===(c.color||0)?" selected":"")+'>'+p.n+'</option>';}).join("");
    h+='<tr data-ac="'+ACOF[c.id]+'">'+
       '<td><input class="cin nm" data-c="'+c.id+'" data-k="name" value="'+esc(c.name)+'" size="6"></td>'+
       '<td><input class="cin" data-c="'+c.id+'" data-k="lm" value="'+esc(c.lm)+'" size="9"></td>'+
       '<td class="num"><input class="nin" type="number" min="0" max="99" data-c="'+c.id+'" data-k="m" value="'+m+'"></td>'+
       '<td><input class="cin" data-c="'+c.id+'" data-k="lw" value="'+esc(c.lw)+'" size="9"></td>'+
       '<td class="num"><input class="nin" type="number" min="0" max="99" data-c="'+c.id+'" data-k="w" value="'+w+'"></td>'+
       '<td><select class="cin sel" data-c="'+c.id+'" data-k="mode"><option value="TR"'+(c.mode==="TR"?" selected":"")+'>Toprope</option>'+
         '<option value="Vorstieg"'+(c.mode!=="TR"?" selected":"")+'>Vorstieg</option></select></td>'+
       '<td><select class="cin sel" data-c="'+c.id+'" data-k="color">'+pal+'</select></td>'+
       '<td class="num">'+n+'</td><td class="num">'+min+'</td>'+
       '<td class="num"><input type="checkbox" class="cq" data-c="'+c.id+'"'+(classInPlan(pq,c.id)?" checked":"")+'></td>'+
       '<td class="num"><input type="checkbox" class="cf" data-c="'+c.id+'"'+(classInPlan(pf,c.id)?" checked":"")+'></td>'+
       '<td><button class="rdel icon-btn bad cdel" type="button" data-c="'+c.id+'" title="Wertungsklasse löschen" aria-label="Wertungsklasse '+esc(c.name||c.id)+' löschen"'+(CFG.classes.length<2?" disabled":"")+'>'+XMARK_SVG+'</button></td></tr>';
  });
  h+='<tr class="sum"><td>Summe</td><td></td><td class="num">'+tot.m+'</td><td></td><td class="num">'+tot.w+'</td>'+
     '<td></td><td></td><td class="num">'+tot.n+'</td><td class="num">'+tot.min+'</td><td></td></tr>';
  document.querySelector("#meldtab tbody").innerHTML=h;
  Array.prototype.forEach.call(document.querySelectorAll("#meldtab .nin"),function(inp){
    inp.onchange=function(){
      var v=Math.max(0,Math.min(99,parseInt(this.value,10)||0)); this.value=v;
      var c=CL(this.getAttribute("data-c")); if(!c) return;
      c[this.getAttribute("data-k")]=v; afterCfg();
    };
  });
  Array.prototype.forEach.call(document.querySelectorAll("#meldtab .cin"),function(inp){
    inp.onchange=function(){
      var c=CL(this.getAttribute("data-c")); if(!c) return;
      var k=this.getAttribute("data-k"), v=this.value;
      c[k]=(k==="color")?(parseInt(v,10)||0):(String(v).trim()||c[k]);
      afterCfg(false);
    };
  });
  Array.prototype.forEach.call(document.querySelectorAll("#meldtab .cdel"),function(btn){
    btn.onclick=function(){ openClassDelete(this.getAttribute("data-c")); };
  });
  /* Quali/Finale einzeln je Klasse: ruft addClass()/delClass() nur auf der
     jeweils betroffenen Plan-Instanz auf, nie auf beiden zusammen wie beim
     Löschen der ganzen Klasse. CFG.classes bleibt dabei unverändert - der
     Klassen-Eintrag selbst (Name/Meldezahlen) geht nie verloren. */
  function wireClassToggle(sel,plan,otherSel){
    Array.prototype.forEach.call(document.querySelectorAll(sel),function(cb){
      cb.onchange=function(){
        var id=this.getAttribute("data-c"), c=CL(id); if(!c) return;
        if(!this.checked){
          var other=document.querySelector(otherSel+'[data-c="'+id+'"]');
          if(other&&!other.checked){ this.checked=true; return; }
          plan.delClass(id);
        } else {
          plan.addClass(c);
        }
      };
    });
  }
  wireClassToggle("#meldtab .cq",pq,"#meldtab .cf");
  wireClassToggle("#meldtab .cf",pf,"#meldtab .cq");
}
/* Bestätigungs-Dialog vor dem Löschen (Issue #69: das × war auf dem Handy
   kaum sichtbar - kein :hover - und löschte bisher sofort und endgültig,
   inklusive aller zugehörigen Quali-/Finale-Blöcke und -Gruppen). Gleiches
   Muster wie beim Wettkampf-Löschen, siehe auth.part
   competitionDeleteHtml()/openCompetitionDelete(). */
function classDeleteHtml(c){
  return '<h3>Wertungsklasse löschen</h3>'+
    '<p class="hint" style="margin-top:-8px">Wertungsklasse „'+esc(c.name||c.id)+'" wirklich löschen? Das entfernt auch alle zugehörigen Blöcke und Gruppen im Quali- und Finale-Zeitplan.</p>'+
    '<div class="cfgrow" style="margin-top:14px">'+
      '<button class="fbtn" id="classDelConfirm" type="button">Endgültig löschen</button>'+
      '<button class="fbtn" id="classDelCancel" type="button">Abbrechen</button>'+
    '</div>';
}
function openClassDelete(id){
  if(CFG.classes.length<2) return;
  var c=CL(id); if(!c) return;
  document.getElementById("modalBody").innerHTML=classDeleteHtml(c);
  document.getElementById("classDelCancel").onclick=closeModal;
  document.getElementById("classDelConfirm").onclick=function(){
    CFG.classes=CFG.classes.filter(function(x){return x.id!==id;});
    reindex(); saveCfg(); pq.delClass(id); pf.delClass(id); afterCfg();
    closeModal();
  };
  openModal();
}
function addClass(name,lm,lw,m,w,mode){
  name=String(name||"").trim(); if(!name) return false;
  var id=name.replace(/[^A-Za-z0-9]/g,"")||("K"+CFG.seq);
  if(CL(id)) id=id+(++CFG.seq);
  var used={}; CFG.classes.forEach(function(c){used[c.color]=1;});
  var col=0; for(var i=0;i<PALETTE.length;i++) if(!used[i]){col=i;break;}
  var c={id:id,name:name,color:col,lm:lm||"männlich",lw:lw||"weiblich",
         m:Math.max(0,parseInt(m,10)||0), w:Math.max(0,parseInt(w,10)||0), mode:mode||"TR"};
  CFG.classes.push(c); reindex(); saveCfg();
  pq.addClass(c); pf.addClass(c);
  afterCfg(); return true;
}
/* ================= Zeitfenster ================= */
function renderWin(){
  function set(id,v){var el=document.getElementById(id); if(el) el.value=fmt(v);}
  set("winQs",CFG.win.qs); set("winQe",CFG.win.qe);
  set("winFs",CFG.win.fs); set("winFe",CFG.win.fe);
  ["winBes","finBesIn"].forEach(function(id){var el=document.getElementById(id); if(el) el.value=CFG.win.bes;});
  ["winIso","finIsoIn"].forEach(function(id){var el=document.getElementById(id); if(el) el.value=CFG.win.iso;});
  var out=document.getElementById("winOut");
  if(out) out.textContent="Quali "+fmt(CFG.win.qs)+"–"+fmt(CFG.win.qe)+" · Finale "+fmt(CFG.win.fs)+"–"+fmt(CFG.win.fe)+
    " · erster Finalzug "+fmt(CFG.win.fs+(+CFG.win.bes||0)+(+CFG.win.iso||0));
}
function applyWin(){
  if(CFG.win.qe<=CFG.win.qs) CFG.win.qe=CFG.win.qs+60;
  if(CFG.win.fe<=CFG.win.fs) CFG.win.fe=CFG.win.fs+60;
  saveCfg();
  pq.window(CFG.win.qs,CFG.win.qe);
  pf.window(CFG.win.fs,CFG.win.fe);
  renderWin();
}
